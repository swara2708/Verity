# Verity Backend Environment Configuration

# JWT Secret Key for token signing
JWT_SECRET=

# Google Gemini API Key (Used inside backend/reviews/agents/)
GEMINI_API_KEY=

# Supabase Credentials (Optional for local dev, required for hosted Postgres)
SUPABASE_URL=
SUPABASE_KEY=

# Local SQLite Database File or Hosted Supabase Postgres
VERITY_DB_FILE=