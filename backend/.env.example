# Verity Backend Environment Configuration

# JWT Secret Key for token signing
JWT_SECRET=verity-secret-key-360-review-intelligence-2026

# Anthropic Claude API Key (Used ONLY inside backend/reviews/agents/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase Credentials (Optional for local dev, required for hosted Postgres)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# Local SQLite Database File (Defaults to verity.db)
VERITY_DB_FILE=verity.db
